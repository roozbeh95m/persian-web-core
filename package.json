{
  "name": "@persian-web/core",
  "version": "0.0.0",
  "description": "Core Persian web utilities",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./digits": {
      "types": "./dist/digits/index.d.ts",
      "import": "./dist/digits/index.js"
    },
    "./normalize": {
      "types": "./dist/normalize/index.d.ts",
      "import": "./dist/normalize/index.js"
    },
    "./format": {
      "types": "./dist/format/index.d.ts",
      "import": "./dist/format/index.js"
    },
    "./currency": {
      "types": "./dist/currency/index.d.ts",
      "import": "./dist/currency/index.js"
    },
    "./phone": {
      "types": "./dist/phone/index.d.ts",
      "import": "./dist/phone/index.js"
    },
    "./national-id": {
      "types": "./dist/national-id/index.d.ts",
      "import": "./dist/national-id/index.js"
    },
    "./search": {
      "types": "./dist/search/index.d.ts",
      "import": "./dist/search/index.js"
    },
    "./typography": {
      "types": "./dist/typography/index.d.ts",
      "import": "./dist/typography/index.js"
    },
    "./sort": {
      "types": "./dist/sort/index.d.ts",
      "import": "./dist/sort/index.js"
    },
    "./date": {
      "types": "./dist/date/index.d.ts",
      "import": "./dist/date/index.js"
    },
    "./direction": {
      "types": "./dist/direction/index.d.ts",
      "import": "./dist/direction/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "./node_modules/typescript/bin/tsc -p tsconfig.build.json",
    "typecheck": "./node_modules/typescript/bin/tsc --noEmit -p tsconfig.json",
    "lint": "./node_modules/eslint/bin/eslint.js .",
    "lint:fix": "./node_modules/eslint/bin/eslint.js . --fix",
    "format": "./node_modules/prettier/bin/prettier.cjs --write .",
    "format:check": "./node_modules/prettier/bin/prettier.cjs --check .",
    "test": "./node_modules/vitest/vitest.mjs run",
    "bench": "./node_modules/vitest/vitest.mjs bench",
    "prepare": "./node_modules/husky/bin.js"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.1",
    "@commitlint/config-conventional": "^21.2.0",
    "@eslint/js": "^10.0.1",
    "eslint": "^10.8.1",
    "eslint-config-prettier": "^10.1.8",
    "husky": "^9.1.7",
    "prettier": "^3.9.6",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.67.0",
    "vitest": "^4.1.10"
  }
}
